# Required: Supabase Free project (apply migrations and seed first)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MOBILE_API_BASE_URL=

# Resend SMTP is configured in the Supabase dashboard; these send app emails.
RESEND_API_KEY=
EMAIL_FROM=UpCatch <hello@your-verified-domain.example>

# Optional until OneSignal is configured. Never expose API/alias secrets.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_ALIAS_SECRET=
CRON_SECRET=


# Production: NEXT_PUBLIC_SITE_URL=https://upcatch.co.uk
# Confirm operator details before launch
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
